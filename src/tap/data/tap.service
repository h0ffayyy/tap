[Unit]
Description=Trusted Access Platform (TAP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__TAP_BIN__ run
ExecStop=__TAP_BIN__ stop
Restart=always
RestartSec=10
User=root
Group=root
RuntimeDirectory=tap
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
